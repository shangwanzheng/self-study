{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pscae/ps-cae-cloud-ui": ["./src/vendor/ps-cae-cloud-ui.tsx"]
    }
  },
  "include": ["src"]
}
